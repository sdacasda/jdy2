#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	/usr/bin/athena-runtime apply
}

stop_service() {
	return 0
}

service_triggers() {
	procd_add_reload_trigger athena firewall
}

reload_service() {
	/usr/bin/athena-runtime apply
}

status_service() {
	/usr/bin/athena-runtime status
}
