#!/bin/sh
set -u

ATHENA_LIBDIR="${ATHENA_LIBDIR:-/usr/lib/athena}"
. "$ATHENA_LIBDIR/common.sh"
. "$ATHENA_LIBDIR/daed-recovery.sh"

case "$#" in
0)
	printf '%s\n' 'WARNING: This resets every existing DAED account password.' >&2
	printf '%s' 'Type RESET DAED PASSWORD to continue: ' >&2
	IFS= read -r athena_daed_confirmation || athena_daed_confirmation=""
	;;
1)
	athena_daed_confirmation=$1
	;;
*)
	printf '%s\n' 'usage: athena-daed-reset-password [RESET DAED PASSWORD]' >&2
	exit 64
	;;
esac

athena_daed_reset_password "$athena_daed_confirmation"
